{
    "name": "sado729/project-version",
    "description": "Laravel Project Version Automatically Increase",
    "keywords": ["laravel", "version", "semver", "versioning", "git-hooks", "auto-increment"],
    "license": "MIT",
    "authors": [
        {
            "name": "Sadiq Məmmədov",
            "email": "sadiqmemmedov93@mail.ru"
        }
    ],
    "autoload": {
        "psr-4": {
            "Sado729\\ProjectVersion\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sado729\\ProjectVersion\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sado729\\ProjectVersion\\ProjectVersionServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/events": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "symfony/process": "^6.2|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
